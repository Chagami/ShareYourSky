# Take-home photos (Cloudflare R2). Copy to .env beside this file and fill in — .env is not in
# git, and must never be. With no .env the exhibit runs as before and simply offers no link.
# Setup steps are in the README under "Take-home photos".
#
# Plain KEY=value, no quotes.

# Cloudflare dashboard -> R2 -> Overview: the account ID (also in the S3 API endpoint,
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=

# An R2 API token with Object Read & Write on this one bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket the photos go into.
R2_BUCKET=

# Where that bucket is publicly readable, with no trailing slash: its r2.dev address or a custom
# domain, e.g. https://pub-0123456789abcdef.r2.dev
R2_PUBLIC_BASE_URL=
